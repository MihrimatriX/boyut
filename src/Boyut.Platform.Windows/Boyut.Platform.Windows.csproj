<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plain net10.0 on purpose: every Win32 call is guarded with OperatingSystem.IsWindows(),
    so the CLI (and its tests) still run on Linux/macOS with the managed scanner.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Boyut.Platform.Windows</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Boyut.Core\Boyut.Core.csproj" />
  </ItemGroup>

</Project>
