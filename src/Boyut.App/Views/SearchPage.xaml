<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Boyut.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Boyut.App.Services"
    xmlns:vm="using:Boyut.App.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="ResultItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="HeaderButton" TargetType="HyperlinkButton">
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Gelişmiş arama" />
                <TextBlock Style="{StaticResource Secondary}" Text="Joker karakter, regex ya da sorgu diliyle tarama indeksinde ara; sonuçları toplu yönet." />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CardLabel}"
                    Text="Kapsam:" />
                <TextBlock
                    MaxWidth="360"
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.ScopeText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    Command="{x:Bind ViewModel.ClearScopeCommand}"
                    Content="Tüm taramada ara"
                    Visibility="{x:Bind ViewModel.HasScope, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- Query card -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <SelectorBar x:Name="ModeBar" SelectionChanged="OnModeChanged">
                        <SelectorBarItem IsSelected="True" Text="Joker (*, ?)" />
                        <SelectorBarItem Text="Regex" />
                        <SelectorBarItem Text="Metin" />
                    </SelectorBar>
                    <TextBox
                        x:Name="QueryBox"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource MonoFont}"
                        IsSpellCheckEnabled="False"
                        PlaceholderText="{x:Bind ViewModel.PlaceholderText, Mode=OneWay}"
                        Text="{x:Bind ViewModel.QueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Click="OnSaveSearchClick"
                        ToolTipService.ToolTip="Aramayı kaydet">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE734;" />
                            <TextBlock Text="Kaydet" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind services:Ui.ShowIf(ViewModel.Error), Mode=OneWay}" />

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tokens}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:TokenChip">
                            <Border
                                Padding="10,3"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="12">
                                <TextBlock FontSize="12">
                                    <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Kind}" /><Run Text=" " /><Run FontFamily="{StaticResource MonoFont}" Text="{x:Bind Value}" />
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        MinWidth="150"
                        ItemsSource="{x:Bind ViewModel.SizeFilters}"
                        SelectedIndex="{x:Bind ViewModel.SizeFilter, Mode=TwoWay}" />
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="150"
                        ItemsSource="{x:Bind ViewModel.DateFilters}"
                        SelectedIndex="{x:Bind ViewModel.DateFilter, Mode=TwoWay}" />
                    <ComboBox
                        Grid.Column="2"
                        MinWidth="150"
                        ItemsSource="{x:Bind ViewModel.TypeFilters}"
                        SelectedIndex="{x:Bind ViewModel.TypeFilter, Mode=TwoWay}" />
                    <HyperlinkButton
                        Grid.Column="3"
                        Command="{x:Bind ViewModel.ResetFiltersCommand}"
                        Content="Filtreleri sıfırla" />
                    <StackPanel
                        Grid.Column="4"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="16">
                        <CheckBox Content="Büyük/küçük harf duyarlı" IsChecked="{x:Bind ViewModel.CaseSensitive, Mode=TwoWay}" />
                        <CheckBox Content="Tam yolda eşleştir" IsChecked="{x:Bind ViewModel.FullPath, Mode=TwoWay}" />
                        <CheckBox Content="Klasörleri dahil et" IsChecked="{x:Bind ViewModel.IncludeDirectories, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Saved searches + syntax -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <Border Padding="4,12,4,4" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock
                                Margin="12,0,12,6"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Kayıtlı aramalar" />
                            <ListView
                                IsItemClickEnabled="True"
                                ItemClick="OnSavedClick"
                                ItemsSource="{x:Bind ViewModel.SavedSearches}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SavedSearchItem">
                                        <StackPanel Padding="0,6">
                                            <StackPanel.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Click="OnDeleteSavedClick" Tag="{x:Bind}" Text="Sil" />
                                                </MenuFlyout>
                                            </StackPanel.ContextFlyout>
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                            <TextBlock
                                                FontFamily="{StaticResource MonoFont}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Query}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Padding="4,12,4,4" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock
                                Margin="12,0,12,2"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Sözdizimi" />
                            <TextBlock
                                Margin="12,0,12,6"
                                Style="{StaticResource CardLabel}"
                                Text="Bir örneğe tıklayın, sorguya eklensin."
                                TextWrapping="Wrap" />
                            <ListView
                                IsItemClickEnabled="True"
                                ItemClick="OnSyntaxClick"
                                ItemsSource="{x:Bind ViewModel.Syntax}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SyntaxHint">
                                        <StackPanel Padding="0,6" Spacing="2">
                                            <Border
                                                Padding="6,1"
                                                HorizontalAlignment="Left"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4">
                                                <TextBlock FontFamily="{StaticResource MonoFont}" Text="{x:Bind Code}" />
                                            </Border>
                                            <TextBlock
                                                Style="{StaticResource CardLabel}"
                                                Text="{x:Bind Description}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Results -->
            <Border
                Grid.Column="1"
                Padding="0"
                Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        Padding="16,12"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardLabel}" Text="{x:Bind ViewModel.Detail, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}" />
                            <Button
                                Click="OnShowInTreeClick"
                                Content="Ağaçta göster"
                                IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                            <Button
                                Click="OnRevealClick"
                                Content="Gezgin'de göster"
                                IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                            <Button
                                Click="OnCopyPathsClick"
                                Content="Yolları kopyala"
                                IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                            <Button Click="OnRecycleClick" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                                <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="Geri Dönüşüm'e taşı" />
                            </Button>
                            <Button
                                Click="OnExportClick"
                                IsEnabled="{x:Bind ViewModel.HasResults, Mode=OneWay}"
                                ToolTipService.ToolTip="Sonuçları CSV olarak kaydet">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="14" Glyph="&#xEDE1;" />
                                    <TextBlock Text="CSV" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        Height="36"
                        Padding="24,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <HyperlinkButton
                            Click="OnSortClick"
                            Content="Ad"
                            Style="{StaticResource HeaderButton}"
                            Tag="name" />
                        <HyperlinkButton
                            Grid.Column="1"
                            Click="OnSortClick"
                            Content="Konum"
                            Style="{StaticResource HeaderButton}"
                            Tag="folder" />
                        <HyperlinkButton
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            Click="OnSortClick"
                            Content="Boyut"
                            Style="{StaticResource HeaderButton}"
                            Tag="size" />
                        <HyperlinkButton
                            Grid.Column="3"
                            Click="OnSortClick"
                            Content="Değiştirilme"
                            Style="{StaticResource HeaderButton}"
                            Tag="modified" />
                        <TextBlock
                            Grid.Column="4"
                            Style="{StaticResource ColumnHeader}"
                            Text="Öznitelik" />
                    </Grid>

                    <ListView
                        x:Name="ResultList"
                        Grid.Row="2"
                        Padding="0,4"
                        DoubleTapped="OnResultDoubleTapped"
                        ItemContainerStyle="{StaticResource ResultItemStyle}"
                        ItemsSource="{x:Bind ViewModel.Results}"
                        KeyDown="OnResultKeyDown"
                        SelectionChanged="OnResultSelectionChanged"
                        SelectionMode="Extended">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ResultRow">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon
                                            FontSize="16"
                                            Foreground="#E3A82E"
                                            Glyph="&#xE8B7;"
                                            Visibility="{x:Bind IsDirectory}" />
                                        <Border
                                            MinWidth="40"
                                            Height="20"
                                            Padding="4,0"
                                            VerticalAlignment="Center"
                                            Background="{x:Bind services:Ui.Brush(BadgeColor)}"
                                            CornerRadius="4"
                                            Visibility="{x:Bind IsFile}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="#14202B"
                                                Text="{x:Bind Badge}" />
                                        </Border>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind FullPath}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CardLabel}"
                                        Text="{x:Bind Folder}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontWeight="{x:Bind services:Ui.Weight(IsLarge)}"
                                        Text="{x:Bind SizeText}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Secondary}"
                                        Text="{x:Bind ModifiedText}" />
                                    <TextBlock
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CardLabel}"
                                        Text="{x:Bind Attributes}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}">
                        <FontIcon
                            FontSize="40"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE721;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Eşleşme yok" />
                        <TextBlock
                            MaxWidth="420"
                            HorizontalAlignment="Center"
                            Style="{StaticResource Secondary}"
                            Text="Deseni genişletmeyi deneyin (ör. *.mp4 yerine *.mp*) ya da filtreleri sıfırlayın."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
