<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Boyut.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Boyut.App.Controls"
    xmlns:services="using:Boyut.App.Services"
    xmlns:vm="using:Boyut.App.ViewModels"
    NavigationCacheMode="Required">

    <Grid Padding="{StaticResource DensePagePadding}" RowSpacing="12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SideColumn.Width" Value="0" />
                        <Setter Target="SidePanel.Visibility" Value="Collapsed" />
                        <Setter Target="Body.ColumnSpacing" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Gelişmiş arama" />
                <TextBlock Style="{StaticResource Secondary}" Text="Joker karakter, regex ya da sorgu diliyle tarama indeksinde ara; sonuçları toplu yönet." />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CardLabel}"
                    Text="Kapsam:" />
                <TextBlock
                    MaxWidth="360"
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.ScopeText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    Command="{x:Bind ViewModel.ClearScopeCommand}"
                    Content="Tüm taramada ara"
                    Visibility="{x:Bind ViewModel.HasScope, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- Query card -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <SelectorBar x:Name="ModeBar" SelectionChanged="OnModeChanged">
                        <SelectorBarItem IsSelected="True" Text="Joker (*, ?)" />
                        <SelectorBarItem Text="Regex" />
                        <SelectorBarItem Text="Metin" />
                    </SelectorBar>
                    <TextBox
                        x:Name="QueryBox"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource MonoFont}"
                        IsSpellCheckEnabled="False"
                        PlaceholderText="{x:Bind ViewModel.PlaceholderText, Mode=OneWay}"
                        Text="{x:Bind ViewModel.QueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Click="OnSaveSearchClick"
                        ToolTipService.ToolTip="Aramayı kaydet">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE734;" />
                            <TextBlock Text="Kaydet" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind services:Ui.ShowIf(ViewModel.Error), Mode=OneWay}" />

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tokens}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:TokenChip">
                            <Border
                                Padding="10,3"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="12">
                                <TextBlock FontSize="12">
                                    <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Kind}" /><Run Text=" " /><Run FontFamily="{StaticResource MonoFont}" Text="{x:Bind Value}" />
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        MinWidth="150"
                        AutomationProperties.Name="Boyut filtresi"
                        ItemsSource="{x:Bind ViewModel.SizeFilters}"
                        SelectedIndex="{x:Bind ViewModel.SizeFilter, Mode=TwoWay}" />
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="150"
                        AutomationProperties.Name="Tarih filtresi"
                        ItemsSource="{x:Bind ViewModel.DateFilters}"
                        SelectedIndex="{x:Bind ViewModel.DateFilter, Mode=TwoWay}" />
                    <ComboBox
                        Grid.Column="2"
                        MinWidth="150"
                        AutomationProperties.Name="Tür filtresi"
                        ItemsSource="{x:Bind ViewModel.TypeFilters}"
                        SelectedIndex="{x:Bind ViewModel.TypeFilter, Mode=TwoWay}" />
                    <DropDownButton
                        Grid.Column="3"
                        AutomationProperties.Name="Seçenekler"
                        ToolTipService.ToolTip="Eşleştirme seçenekleri">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE71C;" />
                            <TextBlock Text="Seçenekler" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.CaseSensitive, Mode=TwoWay}" Text="Büyük/küçük harf duyarlı" />
                                <ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.FullPath, Mode=TwoWay}" Text="Tam yolda eşleştir" />
                                <ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.IncludeDirectories, Mode=TwoWay}" Text="Klasörleri dahil et" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <HyperlinkButton
                        Grid.Column="4"
                        Command="{x:Bind ViewModel.ResetFiltersCommand}"
                        Content="Filtreleri sıfırla" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid
            x:Name="Body"
            Grid.Row="2"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideColumn" Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Saved searches + syntax (hidden when the window is narrow) -->
            <ScrollViewer x:Name="SidePanel" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <Border Padding="4,12,4,4" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock
                                Margin="12,0,12,6"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Kayıtlı aramalar" />
                            <ListView
                                IsItemClickEnabled="True"
                                ItemClick="OnSavedClick"
                                ItemsSource="{x:Bind ViewModel.SavedSearches}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SavedSearchItem">
                                        <StackPanel Padding="0,6">
                                            <StackPanel.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Click="OnDeleteSavedClick" Tag="{x:Bind}" Text="Sil" />
                                                </MenuFlyout>
                                            </StackPanel.ContextFlyout>
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                            <TextBlock
                                                FontFamily="{StaticResource MonoFont}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Query}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Padding="4,12,4,4" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock
                                Margin="12,0,12,2"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Sözdizimi" />
                            <TextBlock
                                Margin="12,0,12,6"
                                Style="{StaticResource CardLabel}"
                                Text="Bir örneğe tıklayın, sorguya eklensin."
                                TextWrapping="Wrap" />
                            <ListView
                                IsItemClickEnabled="True"
                                ItemClick="OnSyntaxClick"
                                ItemsSource="{x:Bind ViewModel.Syntax}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SyntaxHint">
                                        <StackPanel Padding="0,6" Spacing="2">
                                            <Border
                                                Padding="6,1"
                                                HorizontalAlignment="Left"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4">
                                                <TextBlock FontFamily="{StaticResource MonoFont}" Text="{x:Bind Code}" />
                                            </Border>
                                            <TextBlock
                                                Style="{StaticResource CardLabel}"
                                                Text="{x:Bind Description}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Results -->
            <Border
                Grid.Column="1"
                Padding="0"
                Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        Padding="16,8,8,8"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardLabel}" Text="{x:Bind ViewModel.Detail, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}"
                                Visibility="{x:Bind services:Ui.ShowIf(ViewModel.SelectionText), Mode=OneWay}" />
                        </StackPanel>
                        <!-- Commands overflow into "…" when the window is narrow -->
                        <CommandBar
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            DefaultLabelPosition="Right">
                            <AppBarButton
                                Click="OnShowInTreeClick"
                                IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                Label="Ağaçta göster">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton
                                Click="OnRevealClick"
                                IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                Label="Gezgin'de göster">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE838;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton
                                Click="OnCopyPathsClick"
                                IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                Label="Yolları kopyala">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton
                                Click="OnRecycleClick"
                                IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                Label="Geri Dönüşüm'e taşı">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator />
                            <AppBarButton
                                Click="OnExportClick"
                                IsEnabled="{x:Bind ViewModel.HasResults, Mode=OneWay}"
                                Label="CSV"
                                ToolTipService.ToolTip="Sonuçları CSV olarak kaydet">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xEDE1;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                    </Grid>

                    <controls:GridHeader
                        Grid.Row="1"
                        Height="36"
                        Padding="24,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Columns="{x:Bind ViewModel.Columns}" />

                    <ListView
                        x:Name="ResultList"
                        Grid.Row="2"
                        Padding="0,4"
                        DoubleTapped="OnResultDoubleTapped"
                        ItemContainerStyle="{StaticResource DenseListItem}"
                        ItemsSource="{x:Bind ViewModel.Results}"
                        KeyDown="OnResultKeyDown"
                        SelectionChanged="OnResultSelectionChanged"
                        SelectionMode="Extended">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ResultRow">
                                <Grid controls:Columns.Layout="{x:Bind vm:SearchViewModel.Current.Columns}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="#E3A82E"
                                            Glyph="&#xE8B7;"
                                            Visibility="{x:Bind IsDirectory}" />
                                        <Border
                                            Background="{x:Bind services:Ui.Brush(BadgeColor)}"
                                            Style="{StaticResource Pill}"
                                            Visibility="{x:Bind IsFile}">
                                            <TextBlock Style="{StaticResource PillText}" Text="{x:Bind Badge}" />
                                        </Border>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            ToolTipService.ToolTip="{x:Bind FullPath}" />
                                    </Grid>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CardLabel}"
                                        Text="{x:Bind Folder}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontWeight="{x:Bind services:Ui.Weight(IsLarge)}"
                                        Text="{x:Bind SizeText}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Secondary}"
                                        Text="{x:Bind ModifiedText}" />
                                    <TextBlock
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CardLabel}"
                                        Text="{x:Bind Attributes}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}">
                        <FontIcon
                            FontSize="40"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE721;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Eşleşme yok" />
                        <TextBlock
                            MaxWidth="420"
                            HorizontalAlignment="Center"
                            Style="{StaticResource Secondary}"
                            Text="Deseni genişletmeyi deneyin (ör. *.mp4 yerine *.mp*) ya da filtreleri sıfırlayın."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
