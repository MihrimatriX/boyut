<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Boyut.App.Views.CleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Boyut.App.Services"
    xmlns:vm="using:Boyut.App.ViewModels"
    NavigationCacheMode="Required">

    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind services:Ui.Hide(ViewModel.Session.HasIndex), Mode=OneWay}">
            <FontIcon
                FontSize="48"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xEA99;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Önce bir tarama yapın" />
        </StackPanel>

        <ScrollViewer Visibility="{x:Bind ViewModel.Session.HasIndex, Mode=OneWay}">
            <StackPanel Padding="{StaticResource PagePadding}" Spacing="16">
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Temizlik ve türler" />
                    <TextBlock Style="{StaticResource Secondary}">
                        <Run Text="Bilinen klasörler ve dosyalar tanındı: " /><Run Text="{x:Bind ViewModel.Session.RootLabel, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <!-- Summary -->
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardLabel}" Text="Güvenle kazanılabilir" />
                            <TextBlock
                                FontSize="34"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.SafeText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource CardLabel}" Text="Gözden geçirilecek" />
                            <TextBlock
                                FontSize="34"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.CautionText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Spacing="6">
                            <Grid>
                                <TextBlock Style="{StaticResource CardLabel}" Text="Seçili" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind ViewModel.SelectedText, Mode=OneWay}" />
                            </Grid>
                            <ProgressBar
                                Height="8"
                                Maximum="100"
                                Value="{x:Bind ViewModel.SelectedPercent, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource CardLabel}"
                                Text="Öğeler Geri Dönüşüm Kutusu'na taşınır; oradan geri alınabilir."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="3"
                            Padding="20,10"
                            VerticalAlignment="Center"
                            Click="OnCleanClick"
                            Content="Seçilenleri temizle"
                            IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                </Border>

                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsAnalyzing, Mode=OneWay}" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!-- Findings -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Findings}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:FindingRow">
                                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid Padding="0,10" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox
                                                MinWidth="0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{x:Bind Title}"
                                                IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                IsEnabled="{x:Bind CanSelect}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border
                                                        Padding="8,1"
                                                        VerticalAlignment="Center"
                                                        Background="{x:Bind services:Ui.Brush(SafetyColor)}"
                                                        CornerRadius="10">
                                                        <TextBlock
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="White"
                                                            Text="{x:Bind SafetyLabel}" />
                                                    </Border>
                                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Style="{StaticResource CardLabel}"
                                                    Text="{x:Bind Description}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind SizeText}" />
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    Style="{StaticResource CardLabel}"
                                                    Text="{x:Bind Locations}" />
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            Text="{x:Bind Advice}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind HasAdvice}" />
                                        <TextBlock
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Style="{StaticResource CardLabel}"
                                            Text="{x:Bind AdminText}"
                                            Visibility="{x:Bind services:Ui.ShowIf(AdminText)}" />
                                        <ItemsRepeater ItemsSource="{x:Bind Paths}">
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PathRow">
                                                    <Grid Padding="0,4" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Text="{x:Bind SizeText}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource CardLabel}"
                                                            Text="{x:Bind Path}"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTipService.ToolTip="{x:Bind Path}" />
                                                        <HyperlinkButton
                                                            Grid.Column="2"
                                                            Command="{x:Bind InspectCommand}"
                                                            Content="İncele" />
                                                        <HyperlinkButton
                                                            Grid.Column="3"
                                                            Command="{x:Bind RevealCommand}"
                                                            Content="Gezgin" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                        <TextBlock
                                            Style="{StaticResource CardLabel}"
                                            Text="{x:Bind MoreText}"
                                            Visibility="{x:Bind services:Ui.ShowIf(MoreText)}" />
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <StackPanel Grid.Column="1" Spacing="16">
                        <!-- Types -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Dosya türleri" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource CardLabel}"
                                        Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" />
                                </Grid>
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Categories}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="10" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CategoryRow">
                                            <Grid ColumnSpacing="10" RowSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border
                                                    Width="10"
                                                    Height="10"
                                                    VerticalAlignment="Center"
                                                    Background="{x:Bind services:Ui.Brush(Color)}"
                                                    CornerRadius="3" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" />
                                                <TextBlock Grid.Column="2">
                                                    <Run FontWeight="SemiBold" Text="{x:Bind SizeText}" /><Run Text="  " /><Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind PercentText}" />
                                                </TextBlock>
                                                <Grid
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Height="6"
                                                    Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    CornerRadius="3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{x:Bind services:BarWidth.Filled(Percent)}" />
                                                        <ColumnDefinition Width="{x:Bind services:BarWidth.Empty(Percent)}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{x:Bind services:Ui.Brush(Color)}" CornerRadius="3" />
                                                </Grid>
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    Style="{StaticResource CardLabel}"
                                                    Text="{x:Bind FilesText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>

                        <!-- Age -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Son değişikliğe göre" />
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Ages}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="8" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AgeRow">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource CardLabel}" Text="{x:Bind Label}" />
                                                <ProgressBar
                                                    Grid.Column="1"
                                                    Style="{StaticResource ShareBar}"
                                                    Value="{x:Bind Percent}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    Text="{x:Bind SizeText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>

                        <!-- Largest files -->
                        <Border Padding="4,12,4,4" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock
                                    Margin="12,0,12,6"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="En büyük dosyalar" />
                                <ListView
                                    IsItemClickEnabled="True"
                                    ItemClick="OnLargestClick"
                                    ItemsSource="{x:Bind ViewModel.LargestFiles}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ResultRow">
                                            <Grid Padding="0,6" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Style="{StaticResource CardLabel}"
                                                        Text="{x:Bind Folder}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind SizeText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- Duplicates -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Kopya dosyalar" />
                                <TextBlock
                                    Style="{StaticResource CardLabel}"
                                    Text="{x:Bind ViewModel.DuplicateStatus, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <ProgressBar
                                    Maximum="100"
                                    Value="{x:Bind ViewModel.DuplicateProgress, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsFindingDuplicates, Mode=OneWay}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{x:Bind services:Ui.Not(ViewModel.IsFindingDuplicates), Mode=OneWay}"
                                        ItemsSource="{x:Bind ViewModel.DuplicateSizes}"
                                        SelectedIndex="{x:Bind ViewModel.DuplicateSizeIndex, Mode=TwoWay}" />
                                    <Button Grid.Column="1" Command="{x:Bind ViewModel.FindDuplicatesCommand}">
                                        <TextBlock Text="{x:Bind services:Ui.DuplicateButton(ViewModel.IsFindingDuplicates), Mode=OneWay}" />
                                    </Button>
                                </Grid>
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Duplicates}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="8" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DuplicateRow">
                                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                <Expander.Header>
                                                    <StackPanel Padding="0,6">
                                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Style="{StaticResource CardLabel}" Text="{x:Bind Summary}" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Spacing="6">
                                                    <ItemsRepeater ItemsSource="{x:Bind Paths}">
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <TextBlock
                                                                    Padding="0,2"
                                                                    Style="{StaticResource CardLabel}"
                                                                    Text="{x:Bind}"
                                                                    TextWrapping="Wrap" />
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                    <Button
                                                        Click="OnRemoveDuplicatesClick"
                                                        Content="Kopyaları Geri Dönüşüm'e taşı (en eskisi kalır)"
                                                        Tag="{x:Bind}" />
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
