<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Boyut.App.Views.TreePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Boyut.App.Controls"
    xmlns:services="using:Boyut.App.Services"
    xmlns:vm="using:Boyut.App.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="TreeItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SideColumn.Width" Value="0" />
                        <Setter Target="SideColumn.MinWidth" Value="0" />
                        <Setter Target="Body.ColumnSpacing" Value="0" />
                        <Setter Target="Body.RowSpacing" Value="12" />
                        <Setter Target="SidePanel.(Grid.Row)" Value="1" />
                        <Setter Target="SidePanel.(Grid.Column)" Value="0" />
                        <Setter Target="SidePanel.MaxHeight" Value="380" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Empty state -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind services:Ui.Hide(ViewModel.HasIndex), Mode=OneWay}">
            <FontIcon
                FontSize="48"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE8B7;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Henüz bir tarama yok" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource Secondary}"
                Text="Ana sayfadan bir sürücü ya da klasör seçin." />
            <Button
                HorizontalAlignment="Center"
                Click="OnGoHome"
                Content="Ana sayfaya git"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <Grid
            Padding="{StaticResource PagePadding}"
            RowSpacing="12"
            Visibility="{x:Bind ViewModel.HasIndex, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Command="{x:Bind ViewModel.GoUpCommand}"
                    IsEnabled="{x:Bind ViewModel.CanGoUp, Mode=OneWay}"
                    ToolTipService.ToolTip="Üst klasör (Alt+↑)">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Up" Modifiers="Menu" />
                    </Button.KeyboardAccelerators>
                    <FontIcon FontSize="14" Glyph="&#xE74A;" />
                </Button>
                <Border
                    Grid.Column="1"
                    Padding="8,0"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <BreadcrumbBar
                        VerticalAlignment="Center"
                        ItemClicked="OnCrumbClicked"
                        ItemsSource="{x:Bind ViewModel.Crumbs}" />
                </Border>
                <ToggleButton
                    Grid.Column="2"
                    IsChecked="{x:Bind ViewModel.ShowTreemap, Mode=TwoWay}"
                    ToolTipService.ToolTip="Treemap ve çubuk görünümü arasında geçiş">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE80A;" />
                        <TextBlock Text="Treemap" />
                    </StackPanel>
                </ToggleButton>
                <DropDownButton Grid.Column="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xEDE1;" />
                        <TextBlock Text="Dışa aktar" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Command="{x:Bind ViewModel.ExportAllCommand}" Text="Tüm ağaç (CSV)" />
                            <MenuFlyoutItem Command="{x:Bind ViewModel.ExportSelectedCommand}" Text="Seçili klasör ve altı (CSV)" />
                            <MenuFlyoutItem Command="{x:Bind ViewModel.ExportLevelCommand}" Text="Seçili klasörün içeriği (CSV, tek düzey)" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Command="{x:Bind ViewModel.SaveSnapshotCommand}" Text="Tarama dosyası (.boyut)" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <SplitButton
                    Grid.Column="4"
                    AutomationProperties.Name="Güncelle"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    IsEnabled="{x:Bind services:Ui.Not(ViewModel.Session.IsScanning), Mode=OneWay}"
                    ToolTipService.ToolTip="Yalnızca değişen klasörleri NTFS değişiklik günlüğüyle güncelle (F5); mümkün değilse baştan tarar">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="Güncelle" />
                    </StackPanel>
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Command="{x:Bind ViewModel.RescanCommand}" Text="Baştan tara" />
                            <MenuFlyoutItem Command="{x:Bind ViewModel.RescanSelectedCommand}" Text="Yalnızca seçili klasörü tara" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </Grid>

            <!-- Summary cards -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.3*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardLabel}" Text="Taranan toplam" />
                            <TextBlock Style="{StaticResource HeroValue}" Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource CardLabel}" Text="{x:Bind ViewModel.AllocatedText, Mode=OneWay}" />
                        </StackPanel>
                        <Border Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource IconBadge}">
                            <FontIcon FontSize="16" Foreground="#A08BFF" Glyph="&#xE9D2;" />
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardLabel}" Text="Dosya sayısı" />
                            <TextBlock Style="{StaticResource CardValue}" Text="{x:Bind ViewModel.FilesText, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource CardLabel}"
                                Text="{x:Bind ViewModel.EngineText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                        <Border Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource IconBadge}">
                            <FontIcon FontSize="16" Foreground="#3ED8F0" Glyph="&#xE8A5;" />
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                Style="{StaticResource CardLabel}"
                                Text="{x:Bind ViewModel.SelectedName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource CardValue}" Text="{x:Bind ViewModel.SelectedSize, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource CardLabel}">
                                <Run Text="Disk kapasitesinin " /><Run Text="{x:Bind ViewModel.SelectedShare, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <Border Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource IconBadge}">
                            <FontIcon FontSize="16" Foreground="#F3B37C" Glyph="&#xE8B7;" />
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Card}">
                    <StackPanel Spacing="4">
                        <Grid>
                            <TextBlock Style="{StaticResource CardLabel}" Text="Boş alan" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{StaticResource CardLabel}"
                                Text="{x:Bind ViewModel.CapacityText, Mode=OneWay}" />
                        </Grid>
                        <TextBlock Style="{StaticResource CardValue}" Text="{x:Bind ViewModel.FreeText, Mode=OneWay}" />
                        <ProgressBar
                            Height="6"
                            Foreground="{x:Bind services:Ui.UsageBrush(ViewModel.UsedPercent), Mode=OneWay}"
                            Maximum="100"
                            Value="{x:Bind ViewModel.UsedPercent, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasVolumeInfo, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Tree + side panel (below the tree when the window is narrow) -->
            <Grid
                x:Name="Body"
                Grid.Row="2"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition x:Name="SideColumn" Width="2*" MinWidth="360" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <controls:GridHeader
                            Height="40"
                            Padding="24,0,24,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Columns="{x:Bind ViewModel.Columns}" />

                        <ListView
                            x:Name="TreeList"
                            Grid.Row="1"
                            Padding="0,4"
                            DoubleTapped="OnRowDoubleTapped"
                            ItemContainerStyle="{StaticResource TreeItemStyle}"
                            ItemsSource="{x:Bind ViewModel.Rows}"
                            KeyDown="OnTreeKeyDown"
                            SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:TreeRow">
                                    <Grid controls:Columns.Layout="{x:Bind vm:TreeViewModel.Current.Columns}" Opacity="{x:Bind Opacity}">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout Opening="OnRowMenuOpening">
                                                <MenuFlyoutItem Click="OnRevealClick" Text="Gezgin'de göster">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE838;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Click="OnOpenClick" Text="Aç" />
                                                <MenuFlyoutItem Click="OnCopyPathClick" Text="Yolu kopyala">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8C8;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Click="OnTerminalClick" Text="Terminalde aç" />
                                                <MenuFlyoutItem Click="OnSearchHereClick" Text="Bu klasörde ara">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE721;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Click="OnRecycleClick" Text="Geri Dönüşüm'e taşı">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>

                                        <StackPanel
                                            Margin="{x:Bind services:Ui.Indent(Depth)}"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Button
                                                Width="24"
                                                Height="24"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{x:Bind ToggleCommand}"
                                                IsTabStop="False">
                                                <FontIcon FontSize="10" Glyph="{x:Bind Chevron, Mode=OneWay}" />
                                            </Button>
                                            <FontIcon
                                                FontSize="16"
                                                Foreground="{x:Bind services:Ui.Brush(GlyphColor)}"
                                                Glyph="{x:Bind Glyph}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind SizeText}" />
                                        <Grid
                                            Grid.Column="2"
                                            ColumnSpacing="8"
                                            Visibility="{x:Bind ShowBar}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="52" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Style="{StaticResource ShareBar}" Value="{x:Bind Percent}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource CardLabel}"
                                                Text="{x:Bind PercentText}" />
                                        </Grid>
                                        <TextBlock
                                            Grid.Column="3"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Secondary}"
                                            Text="{x:Bind FilesText}" />
                                        <TextBlock
                                            Grid.Column="4"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Secondary}"
                                            Text="{x:Bind ModifiedText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <ScrollViewer
                    x:Name="SidePanel"
                    Grid.Column="1"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <!-- Contents of the selected folder -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind ViewModel.BaseName, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource CardLabel}"
                                        Text="{x:Bind ViewModel.BaseSummary, Mode=OneWay}" />
                                </Grid>
                                <controls:TreemapView
                                    x:Name="Treemap"
                                    Height="340"
                                    Items="{x:Bind ViewModel.Tiles, Mode=OneWay}"
                                    TileInvoked="OnTileInvoked"
                                    Visibility="{x:Bind ViewModel.ShowTreemap, Mode=OneWay}" />
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Bars}" Visibility="{x:Bind ViewModel.ShowBars, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BarItem">
                                            <Button
                                                Padding="8,6"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnBarClick"
                                                Tag="{x:Bind Node}">
                                                <Grid ColumnSpacing="12" RowSpacing="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" />
                                                    <Grid
                                                        Grid.Row="1"
                                                        Height="8"
                                                        Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                        CornerRadius="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{x:Bind services:BarWidth.Filled(Percent)}" />
                                                            <ColumnDefinition Width="{x:Bind services:BarWidth.Empty(Percent)}" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="{x:Bind services:Ui.Brush(Color)}" CornerRadius="4" />
                                                    </Grid>
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        Style="{StaticResource CardLabel}"
                                                        Text="{x:Bind PercentText}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <TextBlock Style="{StaticResource CardLabel}" Text="Bir kutuya tıklayarak o klasörün içine girin." />
                            </StackPanel>
                        </Border>

                        <!-- Details -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        FontSize="32"
                                        Foreground="#E3A82E"
                                        Glyph="{x:Bind ViewModel.SelectedGlyph, Mode=OneWay}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                            Text="{x:Bind ViewModel.SelectedName, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            IsTextSelectionEnabled="True"
                                            Style="{StaticResource CardLabel}"
                                            Text="{x:Bind ViewModel.SelectedPath, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnSpacing="12" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardLabel}" Text="Boyut" />
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SelectedSize, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource CardLabel}" Text="Diskte kapladığı" />
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SelectedAllocated, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1">
                                        <TextBlock Style="{StaticResource CardLabel}" Text="Dosya" />
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SelectedFiles, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Style="{StaticResource CardLabel}" Text="Tür" />
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SelectedKind, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2">
                                        <TextBlock Style="{StaticResource CardLabel}" Text="Değiştirilme" />
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SelectedModified, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1">
                                        <TextBlock Style="{StaticResource CardLabel}" Text="Öznitelikler" />
                                        <TextBlock
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind ViewModel.SelectedAttributes, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{x:Bind ViewModel.RevealInExplorerCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE838;" />
                                            <TextBlock Text="Gezgin'de göster" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{x:Bind ViewModel.CopyPathCommand}" ToolTipService.ToolTip="Yolu kopyala">
                                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                    </Button>
                                    <Button Command="{x:Bind ViewModel.SearchHereCommand}" ToolTipService.ToolTip="Bu klasörde ara">
                                        <FontIcon FontSize="14" Glyph="&#xE721;" />
                                    </Button>
                                    <Button
                                        Click="OnRecycleSelectedClick"
                                        IsEnabled="{x:Bind ViewModel.CanGoUp, Mode=OneWay}"
                                        ToolTipService.ToolTip="Geri Dönüşüm'e taşı (Del)">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon
                                                FontSize="14"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Glyph="&#xE74D;" />
                                            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="Geri Dönüşüm'e taşı" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
