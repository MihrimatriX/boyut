<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Boyut.App.Views.TreePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Boyut.App.Controls"
    xmlns:services="using:Boyut.App.Services"
    xmlns:vm="using:Boyut.App.ViewModels"
    NavigationCacheMode="Required">

    <Grid>
        <!-- Empty state -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind services:Ui.Hide(ViewModel.HasIndex), Mode=OneWay}">
            <FontIcon
                FontSize="48"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE8B7;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Henüz bir tarama yok" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource Secondary}"
                Text="Ana sayfadan bir sürücü ya da klasör seçin (Ctrl+O)." />
            <Button
                HorizontalAlignment="Center"
                Click="OnGoHome"
                Content="Ana sayfaya git"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <Grid
            Padding="{StaticResource DensePagePadding}"
            RowSpacing="12"
            Visibility="{x:Bind ViewModel.HasIndex, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar: address bar + commands -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    AutomationProperties.Name="Üst klasör"
                    Command="{x:Bind ViewModel.GoUpCommand}"
                    IsEnabled="{x:Bind ViewModel.CanGoUp, Mode=OneWay}"
                    ToolTipService.ToolTip="Üst klasör (Alt+↑, Geri tuşu)">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Up" Modifiers="Menu" />
                    </Button.KeyboardAccelerators>
                    <FontIcon FontSize="14" Glyph="&#xE74A;" />
                </Button>
                <Border
                    Grid.Column="1"
                    MinHeight="32"
                    Padding="10,0"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8B7;" />
                        <BreadcrumbBar
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            ItemClicked="OnCrumbClicked"
                            ItemsSource="{x:Bind ViewModel.Crumbs}" />
                    </Grid>
                </Border>
                <DropDownButton
                    Grid.Column="2"
                    AutomationProperties.Name="Genişlet"
                    ToolTipService.ToolTip="Ağacı belirli bir düzeye kadar aç ya da hepsini kapat">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                        <TextBlock Text="Genişlet" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem
                                Command="{x:Bind ViewModel.ExpandToLevelCommand}"
                                CommandParameter="1"
                                Text="1 düzey" />
                            <MenuFlyoutItem
                                Command="{x:Bind ViewModel.ExpandToLevelCommand}"
                                CommandParameter="2"
                                Text="2 düzey" />
                            <MenuFlyoutItem
                                Command="{x:Bind ViewModel.ExpandToLevelCommand}"
                                CommandParameter="3"
                                Text="3 düzey" />
                            <MenuFlyoutItem
                                Command="{x:Bind ViewModel.ExpandToLevelCommand}"
                                CommandParameter="4"
                                Text="4 düzey" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Command="{x:Bind ViewModel.CollapseAllCommand}" Text="Tümünü daralt" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton
                    Grid.Column="3"
                    AutomationProperties.Name="Dışa aktar"
                    ToolTipService.ToolTip="CSV ya da tarama dosyası olarak kaydet">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xEDE1;" />
                        <TextBlock Text="Dışa aktar" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Command="{x:Bind ViewModel.ExportAllCommand}" Text="Tüm ağaç (CSV)" />
                            <MenuFlyoutItem Command="{x:Bind ViewModel.ExportSelectedCommand}" Text="Seçili klasör ve altı (CSV)" />
                            <MenuFlyoutItem Command="{x:Bind ViewModel.ExportLevelCommand}" Text="Seçili klasörün içeriği (CSV, tek düzey)" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Command="{x:Bind ViewModel.SaveSnapshotCommand}" Text="Tarama dosyası (.boyut)" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <ToggleButton
                    Grid.Column="4"
                    AutomationProperties.Name="Ayrıntı bölmesi"
                    IsChecked="{x:Bind ViewModel.ShowDetails, Mode=TwoWay}"
                    ToolTipService.ToolTip="Ayrıntı bölmesini göster / gizle">
                    <FontIcon FontSize="14" Glyph="&#xE8A0;" />
                </ToggleButton>
                <SplitButton
                    Grid.Column="5"
                    AutomationProperties.Name="Güncelle"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    IsEnabled="{x:Bind services:Ui.Not(ViewModel.Session.IsScanning), Mode=OneWay}"
                    ToolTipService.ToolTip="Yalnızca değişen klasörleri NTFS değişiklik günlüğüyle güncelle (F5); mümkün değilse baştan tarar">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="Güncelle" />
                    </StackPanel>
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Command="{x:Bind ViewModel.RescanCommand}" Text="Baştan tara" />
                            <MenuFlyoutItem Command="{x:Bind ViewModel.RescanSelectedCommand}" Text="Yalnızca seçili klasörü tara" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </Grid>

            <!-- Tree | splitter | details -->
            <Grid
                x:Name="Body"
                Grid.Row="1"
                SizeChanged="OnBodySizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Padding="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <controls:GridHeader
                            Height="36"
                            Padding="24,0,24,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Columns="{x:Bind ViewModel.Columns}" />

                        <ListView
                            x:Name="TreeList"
                            Grid.Row="1"
                            Padding="0,4"
                            DoubleTapped="OnRowDoubleTapped"
                            ItemContainerStyle="{StaticResource DenseListItem}"
                            ItemsSource="{x:Bind ViewModel.Rows}"
                            KeyDown="OnTreeKeyDown"
                            SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:TreeRow">
                                    <Grid
                                        controls:Columns.Layout="{x:Bind vm:TreeViewModel.Current.Columns}"
                                        Background="Transparent"
                                        Opacity="{x:Bind Opacity}">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout Opening="OnRowMenuOpening">
                                                <MenuFlyoutItem Click="OnRevealClick" Text="Gezgin'de göster">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE838;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Click="OnOpenClick" Text="Aç">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8E5;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem
                                                    Click="OnCopyPathClick"
                                                    KeyboardAcceleratorTextOverride="Ctrl+C"
                                                    Text="Yolu kopyala">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8C8;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Click="OnTerminalClick" Text="Terminalde aç">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE756;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Click="OnSearchHereClick" Text="Bu klasörde ara">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE721;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Click="OnRescanHereClick" Text="Yalnızca bu klasörü tara">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE72C;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem
                                                    Click="OnRecycleClick"
                                                    KeyboardAcceleratorTextOverride="Del"
                                                    Text="Geri Dönüşüm'e taşı">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>

                                        <!-- Name: indent, chevron, then icon + name over a TreeSize-style share bar -->
                                        <Grid Margin="{x:Bind services:Ui.Indent(Depth)}" ColumnSpacing="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Command="{x:Bind ToggleCommand}" Style="{StaticResource ExpanderChevron}">
                                                <FontIcon FontSize="10" Glyph="{x:Bind Chevron, Mode=OneWay}" />
                                            </Button>
                                            <Grid Grid.Column="1">
                                                <Grid
                                                    Height="22"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind ShowBar}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{x:Bind services:BarWidth.Filled(Percent)}" />
                                                        <ColumnDefinition Width="{x:Bind services:BarWidth.Empty(Percent)}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{x:Bind services:Ui.Brush(BarColor)}" CornerRadius="4" />
                                                </Grid>
                                                <Grid Padding="4,0" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="{x:Bind services:Ui.Brush(GlyphColor)}"
                                                        Glyph="{x:Bind Glyph}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Text="{x:Bind Name}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                        <TextBlock
                                            Grid.Column="1"
                                            FontWeight="SemiBold"
                                            Style="{StaticResource CellNumber}"
                                            Text="{x:Bind SizeText}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CellNumber}"
                                            Text="{x:Bind AllocatedText}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            Style="{StaticResource CellNumber}"
                                            Text="{x:Bind PercentText}" />
                                        <TextBlock
                                            Grid.Column="4"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CellNumber}"
                                            Text="{x:Bind FilesText}" />
                                        <TextBlock
                                            Grid.Column="5"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CellNumber}"
                                            Text="{x:Bind FoldersText}" />
                                        <TextBlock
                                            Grid.Column="6"
                                            Style="{StaticResource CellSecondary}"
                                            Text="{x:Bind ModifiedText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <controls:PaneSplitter
                    x:Name="Splitter"
                    Grid.Column="1"
                    DragCompleted="OnSplitterDragCompleted"
                    DragStarted="OnSplitterDragStarted"
                    Dragging="OnSplitterDragging"
                    ResetRequested="OnSplitterReset"
                    Visibility="{x:Bind ViewModel.ShowDetails, Mode=OneWay}" />

                <!-- Details pane: what the selection is, and what its folder is made of -->
                <Border
                    x:Name="DetailsPane"
                    Grid.Column="2"
                    Padding="0"
                    Style="{StaticResource Card}"
                    Visibility="{x:Bind ViewModel.ShowDetails, Mode=OneWay}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- The selected item -->
                        <Grid Padding="16,14,16,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border VerticalAlignment="Center" Style="{StaticResource IconBadge}">
                                <FontIcon
                                    FontSize="20"
                                    Foreground="{x:Bind services:Ui.Brush(ViewModel.SelectedGlyphColor), Mode=OneWay}"
                                    Glyph="{x:Bind ViewModel.SelectedGlyph, Mode=OneWay}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    MaxLines="1"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind ViewModel.SelectedName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    MaxLines="1"
                                    Style="{StaticResource CardLabel}"
                                    Text="{x:Bind ViewModel.SelectedPath, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.SelectedPath, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource CardValue}"
                                    Text="{x:Bind ViewModel.SelectedSize, Mode=OneWay}" />
                                <TextBlock HorizontalAlignment="Right" Style="{StaticResource CardLabel}">
                                    <Run Text="üst klasörün " /><Run Text="{x:Bind ViewModel.SelectedParentShare, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <SelectorBar
                            x:Name="DetailsTabs"
                            Grid.Row="1"
                            Margin="8,0"
                            SelectionChanged="OnDetailsTabChanged">
                            <SelectorBarItem Text="Harita" />
                            <SelectorBarItem Text="İçerik" />
                            <SelectorBarItem Text="Türler" />
                            <SelectorBarItem Text="Dosyalar" />
                            <SelectorBarItem Text="Bilgi" />
                        </SelectorBar>

                        <!-- The folder the tabs describe -->
                        <Grid
                            Grid.Row="2"
                            Padding="16,8,16,6"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                MaxLines="1"
                                Style="{StaticResource CardLabel}"
                                Text="{x:Bind ViewModel.BaseCaption, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <ProgressRing
                                Grid.Column="1"
                                Width="14"
                                Height="14"
                                IsActive="{x:Bind ViewModel.IsDetailsBusy, Mode=OneWay}" />
                        </Grid>

                        <Grid Grid.Row="3">
                            <!-- Harita -->
                            <Grid
                                Padding="12,2,12,12"
                                RowSpacing="6"
                                Visibility="{x:Bind services:Ui.Tab(ViewModel.DetailsTab, 0), Mode=OneWay}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <controls:TreemapView
                                    Items="{x:Bind ViewModel.Tiles, Mode=OneWay}"
                                    SelectedNode="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
                                    TileInvoked="OnTileInvoked" />
                                <TextBlock
                                    Grid.Row="1"
                                    Style="{StaticResource CardLabel}"
                                    Text="Kutu alan = boyut. Bir kutuya tıklayınca o klasöre girersiniz; büyük klasörler içeriklerini de gösterir."
                                    TextWrapping="Wrap" />
                            </Grid>

                            <!-- İçerik -->
                            <ScrollViewer Visibility="{x:Bind services:Ui.Tab(ViewModel.DetailsTab, 1), Mode=OneWay}">
                                <StackPanel Padding="8,0,8,12">
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Contents}">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ContentRow">
                                                <Button
                                                    Padding="8,6"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Click="OnContentClick"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    Tag="{x:Bind Node}"
                                                    ToolTipService.ToolTip="{x:Bind Detail}">
                                                    <Grid ColumnSpacing="10" RowSpacing="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <FontIcon
                                                            Grid.RowSpan="2"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Foreground="{x:Bind services:Ui.Brush(GlyphColor)}"
                                                            Glyph="{x:Bind Glyph}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Text="{x:Bind Name}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="NoWrap" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            HorizontalAlignment="Right"
                                                            FontWeight="SemiBold"
                                                            Text="{x:Bind SizeText}" />
                                                        <Grid
                                                            Grid.Row="1"
                                                            Grid.Column="1"
                                                            Height="6"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                            CornerRadius="3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{x:Bind services:BarWidth.Filled(Percent)}" />
                                                                <ColumnDefinition Width="{x:Bind services:BarWidth.Empty(Percent)}" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Background="{x:Bind services:Ui.Brush(Color)}" CornerRadius="3" />
                                                        </Grid>
                                                        <TextBlock
                                                            Grid.Row="1"
                                                            Grid.Column="2"
                                                            HorizontalAlignment="Right"
                                                            Style="{StaticResource CardLabel}"
                                                            Text="{x:Bind PercentText}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <TextBlock
                                        Margin="8,8,8,0"
                                        Style="{StaticResource CardLabel}"
                                        Text="{x:Bind ViewModel.ContentsMore, Mode=OneWay}"
                                        Visibility="{x:Bind services:Ui.ShowIf(ViewModel.ContentsMore), Mode=OneWay}" />
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Türler -->
                            <ScrollViewer Visibility="{x:Bind services:Ui.Tab(ViewModel.DetailsTab, 2), Mode=OneWay}">
                                <StackPanel Padding="16,4,16,16" Spacing="10">
                                    <Grid>
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Dosya türleri" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource CardLabel}"
                                            Text="{x:Bind ViewModel.TypesSummary, Mode=OneWay}" />
                                    </Grid>
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Categories}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="10" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CategoryRow">
                                                <Grid ColumnSpacing="10" RowSpacing="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Border
                                                        Width="10"
                                                        Height="10"
                                                        VerticalAlignment="Center"
                                                        Background="{x:Bind services:Ui.Brush(Color)}"
                                                        CornerRadius="3" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" />
                                                    <TextBlock Grid.Column="2">
                                                        <Run FontWeight="SemiBold" Text="{x:Bind SizeText}" /><Run Text="  " /><Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind PercentText}" />
                                                    </TextBlock>
                                                    <Grid
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        Height="6"
                                                        Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                        CornerRadius="3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{x:Bind services:BarWidth.Filled(Percent)}" />
                                                            <ColumnDefinition Width="{x:Bind services:BarWidth.Empty(Percent)}" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="{x:Bind services:Ui.Brush(Color)}" CornerRadius="3" />
                                                    </Grid>
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Grid.Column="2"
                                                        HorizontalAlignment="Right"
                                                        Style="{StaticResource CardLabel}"
                                                        Text="{x:Bind FilesText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>

                                    <TextBlock
                                        Margin="0,10,0,0"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="Uzantılar" />
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Extensions}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="6" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CategoryRow">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        HorizontalAlignment="Left"
                                                        Background="{x:Bind services:Ui.Brush(Color)}"
                                                        Style="{StaticResource Pill}">
                                                        <TextBlock
                                                            Style="{StaticResource PillText}"
                                                            Text="{x:Bind Name}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                    <ProgressBar
                                                        Grid.Column="1"
                                                        Style="{StaticResource ShareBar}"
                                                        Value="{x:Bind services:Ui.Clamp100(Percent)}" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        MinWidth="150"
                                                        HorizontalAlignment="Right"
                                                        HorizontalTextAlignment="Right">
                                                        <Run FontWeight="SemiBold" Text="{x:Bind SizeText}" /><Run Text="  " /><Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind FilesText}" />
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Dosyalar -->
                            <Grid Visibility="{x:Bind services:Ui.Tab(ViewModel.DetailsTab, 3), Mode=OneWay}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ListView
                                    x:Name="LargestList"
                                    Padding="0,0,0,4"
                                    DoubleTapped="OnLargestDoubleTapped"
                                    ItemContainerStyle="{StaticResource DenseListItem}"
                                    ItemsSource="{x:Bind ViewModel.Largest}"
                                    SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ResultRow">
                                            <Grid Padding="0,4" ColumnSpacing="10">
                                                <Grid.ContextFlyout>
                                                    <MenuFlyout Opening="OnLargestMenuOpening">
                                                        <MenuFlyoutItem Click="OnLargestShowInTreeClick" Text="Ağaçta göster">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE8B7;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="OnLargestRevealClick" Text="Gezgin'de göster">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE838;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="OnLargestCopyClick" Text="Yolu kopyala">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE8C8;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Click="OnLargestRecycleClick" Text="Geri Dönüşüm'e taşı">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74D;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Grid.ContextFlyout>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{x:Bind services:Ui.Brush(BadgeColor)}" Style="{StaticResource Pill}">
                                                    <TextBlock Style="{StaticResource PillText}" Text="{x:Bind Badge}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{x:Bind Name}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                                    <TextBlock
                                                        Style="{StaticResource CardLabel}"
                                                        Text="{x:Bind Folder}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap"
                                                        ToolTipService.ToolTip="{x:Bind FullPath}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind SizeText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="16,4,16,10"
                                    Style="{StaticResource CardLabel}"
                                    Text="Bu klasörün altındaki en büyük 100 dosya. Çift tık: ağaçta göster, sağ tık: diğer işlemler."
                                    TextWrapping="Wrap" />
                            </Grid>

                            <!-- Bilgi -->
                            <ScrollViewer Visibility="{x:Bind services:Ui.Tab(ViewModel.DetailsTab, 4), Mode=OneWay}">
                                <StackPanel Padding="16,8,16,16" Spacing="16">
                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardLabel}" Text="Boyut" />
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SelectedSize, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource CardLabel}" Text="Diskte kapladığı" />
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SelectedAllocated, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1">
                                            <TextBlock Style="{StaticResource CardLabel}" Text="Dosya" />
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SelectedFiles, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock Style="{StaticResource CardLabel}" Text="Alt klasör" />
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SelectedFolders, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2">
                                            <TextBlock Style="{StaticResource CardLabel}" Text="Üst klasördeki payı" />
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SelectedParentShare, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1">
                                            <TextBlock Style="{StaticResource CardLabel}" Text="Disk kapasitesindeki payı" />
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SelectedDiskShare, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="3">
                                            <TextBlock Style="{StaticResource CardLabel}" Text="Tür" />
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SelectedKind, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Grid.Column="1">
                                            <TextBlock Style="{StaticResource CardLabel}" Text="Değiştirilme" />
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SelectedModified, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
                                            <TextBlock Style="{StaticResource CardLabel}" Text="Öznitelikler" />
                                            <TextBlock
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind ViewModel.SelectedAttributes, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource CardLabel}" Text="Konum" />
                                        <TextBlock
                                            IsTextSelectionEnabled="True"
                                            FontFamily="{StaticResource MonoFont}"
                                            FontSize="12"
                                            Text="{x:Bind ViewModel.SelectedPath, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Spacing="2">
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{x:Bind ViewModel.RevealInExplorerCommand}"
                                            Style="{StaticResource SubtleButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon FontSize="14" Glyph="&#xE838;" />
                                                <TextBlock Text="Gezgin'de göster" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{x:Bind ViewModel.OpenItemCommand}"
                                            Style="{StaticResource SubtleButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                                                <TextBlock Text="Aç" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{x:Bind ViewModel.CopyPathCommand}"
                                            Style="{StaticResource SubtleButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                                <TextBlock Text="Yolu kopyala (Ctrl+C)" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{x:Bind ViewModel.OpenTerminalCommand}"
                                            Style="{StaticResource SubtleButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon FontSize="14" Glyph="&#xE756;" />
                                                <TextBlock Text="Terminalde aç" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{x:Bind ViewModel.SearchHereCommand}"
                                            Style="{StaticResource SubtleButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon FontSize="14" Glyph="&#xE721;" />
                                                <TextBlock Text="Bu klasörde ara" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnRecycleSelectedClick"
                                            IsEnabled="{x:Bind ViewModel.CanGoUp, Mode=OneWay}"
                                            Style="{StaticResource SubtleButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon
                                                    FontSize="14"
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                    Glyph="&#xE74D;" />
                                                <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="Geri Dönüşüm'e taşı (Del)" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
