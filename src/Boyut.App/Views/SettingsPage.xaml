<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Boyut.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel
            MaxWidth="900"
            Padding="{StaticResource PagePadding}"
            HorizontalAlignment="Left"
            Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Ayarlar" />

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Görünüm" />
                    <RadioButtons
                        x:Name="ThemeButtons"
                        Header="Tema"
                        SelectionChanged="OnThemeChanged">
                        <x:String>Sistem ayarını kullan</x:String>
                        <x:String>Açık</x:String>
                        <x:String>Koyu</x:String>
                    </RadioButtons>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Tarama motoru" />
                    <TextBlock x:Name="EngineStatus" TextWrapping="Wrap" />
                    <TextBlock
                        Style="{StaticResource Secondary}"
                        Text="NTFS sürücülerde Boyut, Master File Table'ı (MFT) doğrudan okur: milyonlarca dosya birkaç saniyede listelenir, sabit bağlantılar bir kez sayılır, sıkıştırılmış ve seyrek dosyaların diskte kapladığı gerçek alan görülür. Bunun için tarama sırasında yönetici izni istenir; arayüz yönetici olarak çalışmaz. Ağ sürücüleri, exFAT/FAT32 ve izin verilmediği durumlarda klasör taraması kullanılır."
                        TextWrapping="Wrap" />
                    <Button Click="OnRestartElevated" Content="Boyut'u yönetici olarak yeniden başlat" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Arka plan izleme" />
                    <TextBlock
                        Style="{StaticResource Secondary}"
                        Text="Boyut seçtiğiniz sürücüleri Windows Görev Zamanlayıcı ile düzenli olarak tarar ve tarama geçmişine ekler. Boş alan eşiğin altına düştüğünde ya da bir sürücü hızla büyüdüğünde bildirim gösterir; bildirime tıklayınca Değişimler sayfası açılır. Açarken Windows bir kez yönetici izni ister (hızlı MFT taraması için)."
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        x:Name="MonitorSwitch"
                        Header="Düzenli tarama"
                        OffContent="Kapalı"
                        OnContent="Açık"
                        Toggled="OnMonitorToggled" />
                    <TextBlock
                        x:Name="MonitorStatus"
                        Style="{StaticResource CardLabel}"
                        TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource CardLabel}" Text="İzlenecek sürücüler" />
                    <StackPanel
                        x:Name="MonitorDrives"
                        Orientation="Horizontal"
                        Spacing="12" />
                    <RadioButtons
                        x:Name="MonitorFrequency"
                        Header="Sıklık"
                        SelectionChanged="OnMonitorFrequencyChanged">
                        <x:String>Günde bir (12:00; bilgisayar kapalıysa ilk fırsatta)</x:String>
                        <x:String>Saatte bir</x:String>
                    </RadioButtons>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <NumberBox
                            x:Name="FreeGb"
                            Width="280"
                            Header="Boş alan şunun altına düşerse (GB)"
                            Maximum="100000"
                            Minimum="1"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="OnThresholdChanged" />
                        <NumberBox
                            x:Name="GrowthGb"
                            Width="280"
                            Header="Son taramadan beri şu kadar büyürse (GB, 0 = kapalı)"
                            Maximum="100000"
                            Minimum="0"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="OnThresholdChanged" />
                    </StackPanel>
                    <Button
                        x:Name="RunNowButton"
                        Click="OnMonitorRunNow"
                        Content="Şimdi çalıştır" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Veriler" />
                    <TextBlock x:Name="DataFolder" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnOpenDataFolder" Content="Klasörü aç" />
                        <Button Click="OnClearRecent" Content="Tarama geçmişini sil" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Hakkında" />
                    <TextBlock x:Name="VersionText" />
                    <TextBlock Style="{StaticResource Secondary}" Text="Komut satırı sürümü: boyut scan | search | types | cleanup | dupes" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
