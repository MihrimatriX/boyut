<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Boyut.App.Views.ChangesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Boyut.App.Controls"
    xmlns:services="using:Boyut.App.Services"
    xmlns:vm="using:Boyut.App.ViewModels"
    NavigationCacheMode="Required">

    <Grid Padding="{StaticResource DensePagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- What to compare -->
        <StackPanel Spacing="12">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Değişimler" />
                <TextBlock
                    Style="{StaticResource Secondary}"
                    Text="Aynı klasörün iki taramasını karşılaştırır: ne büyüdü, ne eklendi, ne silindi."
                    TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    HorizontalAlignment="Stretch"
                    Header="Klasör / sürücü"
                    ItemsSource="{x:Bind ViewModel.Roots}"
                    SelectedItem="{x:Bind ViewModel.SelectedRoot, Mode=TwoWay}" />
                <ComboBox
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Header="Önceki tarama"
                    ItemsSource="{x:Bind ViewModel.Snapshots}"
                    SelectedItem="{x:Bind ViewModel.Before, Mode=TwoWay}" />
                <ComboBox
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    Header="Sonraki tarama"
                    ItemsSource="{x:Bind ViewModel.Snapshots}"
                    SelectedItem="{x:Bind ViewModel.After, Mode=TwoWay}" />
                <ProgressRing
                    Grid.Column="3"
                    Width="24"
                    Height="24"
                    Margin="0,0,0,4"
                    VerticalAlignment="Bottom"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            </Grid>
        </StackPanel>

        <!-- Summary -->
        <Grid
            Grid.Row="1"
            ColumnSpacing="12"
            Visibility="{x:Bind ViewModel.HasDiff, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardLabel}" Text="Toplam değişim" />
                    <TextBlock
                        Foreground="{x:Bind services:Ui.Brush(ViewModel.TotalDeltaColor), Mode=OneWay}"
                        Style="{StaticResource CardValue}"
                        Text="{x:Bind ViewModel.TotalDeltaText, Mode=OneWay}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardLabel}" Text="Dosya sayısı" />
                    <TextBlock Style="{StaticResource CardValue}" Text="{x:Bind ViewModel.FilesDeltaText, Mode=OneWay}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardLabel}" Text="Boş alan" />
                    <TextBlock Style="{StaticResource CardValue}" Text="{x:Bind ViewModel.FreeDeltaText, Mode=OneWay}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardLabel}" Text="Aradaki süre" />
                    <TextBlock Style="{StaticResource CardValue}" Text="{x:Bind ViewModel.SpanText, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="4">
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind services:Ui.HasText(ViewModel.GrowthText), Mode=OneWay}"
                Message="{x:Bind ViewModel.GrowthText, Mode=OneWay}"
                Severity="Warning" />
            <TextBlock
                Style="{StaticResource Secondary}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind services:Ui.ShowIf(ViewModel.HasDiff, ViewModel.StatusText), Mode=OneWay}" />
        </StackPanel>

        <!-- Nothing to compare yet -->
        <StackPanel
            Grid.Row="3"
            MaxWidth="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind services:Ui.Hide(ViewModel.HasDiff), Mode=OneWay}">
            <FontIcon
                FontSize="48"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE81C;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource Secondary}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- Diff tree + actions -->
        <Grid
            Grid.Row="3"
            ColumnSpacing="12"
            Visibility="{x:Bind ViewModel.HasDiff, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Padding="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <controls:GridHeader
                        Height="36"
                        Padding="12,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Columns="{x:Bind ViewModel.Columns}" />

                    <ListView
                        x:Name="DiffList"
                        Grid.Row="1"
                        Padding="0,4"
                        DoubleTapped="OnRowDoubleTapped"
                        ItemContainerStyle="{StaticResource DenseListItem}"
                        ItemsSource="{x:Bind ViewModel.Rows}"
                        KeyDown="OnListKeyDown"
                        SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DiffRow">
                                <Grid controls:Columns.Layout="{x:Bind vm:ChangesViewModel.Current.Columns}" Opacity="{x:Bind Opacity}">
                                    <Grid Margin="{x:Bind services:Ui.Indent(Depth)}" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Command="{x:Bind ToggleCommand}" Style="{StaticResource ExpanderChevron}">
                                            <FontIcon FontSize="10" Glyph="{x:Bind Chevron, Mode=OneWay}" />
                                        </Button>
                                        <FontIcon
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="{x:Bind services:Ui.Brush(GlyphColor)}"
                                            Glyph="{x:Bind Glyph}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </Grid>
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Secondary}"
                                        Text="{x:Bind OldText}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind NewText}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Foreground="{x:Bind services:Ui.Brush(DeltaColor)}"
                                        Text="{x:Bind DeltaText}" />
                                    <TextBlock
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CardLabel}"
                                        Text="{x:Bind KindText}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <StackPanel
                Grid.Column="1"
                Width="200"
                Spacing="8">
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.RevealInTreeCommand}"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                        <TextBlock Text="Klasör ağacında aç" />
                    </StackPanel>
                </Button>
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.RevealInExplorerCommand}"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE838;" />
                        <TextBlock Text="Gezgin'de göster" />
                    </StackPanel>
                </Button>
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.CopyPathCommand}"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                        <TextBlock Text="Yolu kopyala" />
                    </StackPanel>
                </Button>
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource CardLabel}"
                    Text="Yalnızca boyutu değişen öğeler listelenir. Turuncu: büyüdü, yeşil: küçüldü."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
