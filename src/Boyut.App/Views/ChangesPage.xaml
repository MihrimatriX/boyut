<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Boyut.App.Views.ChangesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Boyut.App.Controls"
    xmlns:services="using:Boyut.App.Services"
    xmlns:vm="using:Boyut.App.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="DiffItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- What to compare -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Bottom"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Değişimler" />
            <ComboBox
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Header="Klasör / sürücü"
                ItemsSource="{x:Bind ViewModel.Roots}"
                SelectedItem="{x:Bind ViewModel.SelectedRoot, Mode=TwoWay}" />
            <ComboBox
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                Header="Önceki tarama"
                ItemsSource="{x:Bind ViewModel.Snapshots}"
                SelectedItem="{x:Bind ViewModel.Before, Mode=TwoWay}" />
            <ComboBox
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                Header="Sonraki tarama"
                ItemsSource="{x:Bind ViewModel.Snapshots}"
                SelectedItem="{x:Bind ViewModel.After, Mode=TwoWay}" />
            <ProgressRing
                Grid.Column="4"
                Width="24"
                Height="24"
                VerticalAlignment="Bottom"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        </Grid>

        <!-- Summary -->
        <Grid
            Grid.Row="1"
            ColumnSpacing="12"
            Visibility="{x:Bind ViewModel.HasDiff, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardLabel}" Text="Toplam değişim" />
                    <TextBlock
                        Foreground="{x:Bind services:Ui.Brush(ViewModel.TotalDeltaColor), Mode=OneWay}"
                        Style="{StaticResource CardValue}"
                        Text="{x:Bind ViewModel.TotalDeltaText, Mode=OneWay}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardLabel}" Text="Dosya sayısı" />
                    <TextBlock Style="{StaticResource CardValue}" Text="{x:Bind ViewModel.FilesDeltaText, Mode=OneWay}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardLabel}" Text="Boş alan" />
                    <TextBlock Style="{StaticResource CardValue}" Text="{x:Bind ViewModel.FreeDeltaText, Mode=OneWay}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardLabel}" Text="Aradaki süre" />
                    <TextBlock Style="{StaticResource CardValue}" Text="{x:Bind ViewModel.SpanText, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="4">
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind services:Ui.HasText(ViewModel.GrowthText), Mode=OneWay}"
                Message="{x:Bind ViewModel.GrowthText, Mode=OneWay}"
                Severity="Warning" />
            <TextBlock
                Style="{StaticResource Secondary}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind services:Ui.ShowIf(ViewModel.StatusText), Mode=OneWay}" />
        </StackPanel>

        <!-- Diff tree + actions -->
        <Grid
            Grid.Row="3"
            ColumnSpacing="12"
            Visibility="{x:Bind ViewModel.HasDiff, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Padding="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <controls:GridHeader
                        Height="40"
                        Padding="24,0,24,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Columns="{x:Bind ViewModel.Columns}" />

                    <ListView
                        x:Name="DiffList"
                        Grid.Row="1"
                        Padding="0,4"
                        DoubleTapped="OnRowDoubleTapped"
                        ItemContainerStyle="{StaticResource DiffItemStyle}"
                        ItemsSource="{x:Bind ViewModel.Rows}"
                        KeyDown="OnListKeyDown"
                        SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DiffRow">
                                <Grid controls:Columns.Layout="{x:Bind vm:ChangesViewModel.Current.Columns}" Opacity="{x:Bind Opacity}">
                                    <StackPanel
                                        Margin="{x:Bind services:Ui.Indent(Depth)}"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <Button
                                            Width="24"
                                            Height="24"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{x:Bind ToggleCommand}"
                                            IsTabStop="False">
                                            <FontIcon FontSize="10" Glyph="{x:Bind Chevron, Mode=OneWay}" />
                                        </Button>
                                        <FontIcon
                                            FontSize="16"
                                            Foreground="{x:Bind services:Ui.Brush(GlyphColor)}"
                                            Glyph="{x:Bind Glyph}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Secondary}"
                                        Text="{x:Bind OldText}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind NewText}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Foreground="{x:Bind services:Ui.Brush(DeltaColor)}"
                                        Text="{x:Bind DeltaText}" />
                                    <TextBlock
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CardLabel}"
                                        Text="{x:Bind KindText}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <StackPanel
                Grid.Column="1"
                Width="200"
                Spacing="8">
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.RevealInTreeCommand}"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                        <TextBlock Text="Klasör ağacında aç" />
                    </StackPanel>
                </Button>
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.RevealInExplorerCommand}"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE838;" />
                        <TextBlock Text="Gezgin'de göster" />
                    </StackPanel>
                </Button>
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.CopyPathCommand}"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                        <TextBlock Text="Yolu kopyala" />
                    </StackPanel>
                </Button>
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource CardLabel}"
                    Text="Yalnızca boyutu değişen öğeler listelenir. Turuncu: büyüdü, yeşil: küçüldü."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
