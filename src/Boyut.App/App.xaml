<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Boyut.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Plain Windows 11 (Fluent 2) materials: Mica behind, layer and card fills from the system,
                the user's accent colour. Data colours (bars, treemap, file types) live in Services/Ui.cs.
            -->

            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
            <Thickness x:Key="PagePadding">24,16,24,24</Thickness>
            <!-- Dense pages (tree, search, changes) use the space for data -->
            <Thickness x:Key="DensePagePadding">16,12,16,12</Thickness>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- Rounded icon tile at the start of a card or header -->
            <Style x:Key="IconBadge" TargetType="Border">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="CardLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="CardValue" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- The one number a card is about -->
            <Style x:Key="HeroValue" TargetType="TextBlock" BasedOn="{StaticResource CardValue}">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}" />

            <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- Numbers in list cells: right aligned, one line -->
            <Style x:Key="CellNumber" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <Style x:Key="CellSecondary" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- Rows of the tree, search and change lists: compact like Explorer's details view -->
            <Style x:Key="DenseListItem" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <!-- Chevron that opens and closes a tree row -->
            <Style x:Key="ExpanderChevron" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- List header (Controls/GridColumns.cs): sortable cell and the resize divider between cells -->
            <Style x:Key="GridHeaderCell" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="Margin" Value="-4,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="GridHeaderDivider" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="Margin" Value="0,9" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>

            <!-- Grip in the middle of Controls/PaneSplitter.cs -->
            <Style x:Key="PaneSplitterGrip" TargetType="Border">
                <Setter Property="Width" Value="4" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource ControlStrongFillColorDefaultBrush}" />
            </Style>

            <!-- Thin usage bar, e.g. disk usage or a share of a total -->
            <Style x:Key="ShareBar" TargetType="ProgressBar">
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="100" />
                <Setter Property="MinHeight" Value="6" />
                <Setter Property="Height" Value="6" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Small rounded label, e.g. a file extension or a safety level -->
            <Style x:Key="Pill" TargetType="Border">
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="PillText" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="#14202B" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
