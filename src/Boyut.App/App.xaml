<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Boyut.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <!-- Indigo → cyan, for hero numbers, bars and highlighted borders -->
                    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#A08BFF" />
                        <GradientStop Offset="1" Color="#3ED8F0" />
                    </LinearGradientBrush>
                    <!-- Glass card: translucent fill over the glowing backdrop, light catching the top edge -->
                    <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#1CFFFFFF" />
                        <GradientStop Offset="1" Color="#0AFFFFFF" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="GlassStroke" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#38FFFFFF" />
                        <GradientStop Offset="1" Color="#0CFFFFFF" />
                    </LinearGradientBrush>
                    <RadialGradientBrush x:Key="GlowA" Center="0.1,0" GradientOrigin="0.1,0" RadiusX="0.7" RadiusY="0.9">
                        <GradientStop Offset="0" Color="#667C5CFF" />
                        <GradientStop Offset="1" Color="#007C5CFF" />
                    </RadialGradientBrush>
                    <RadialGradientBrush x:Key="GlowB" Center="1,1" GradientOrigin="1,1" RadiusX="0.7" RadiusY="0.8">
                        <GradientStop Offset="0" Color="#4422D3EE" />
                        <GradientStop Offset="1" Color="#0022D3EE" />
                    </RadialGradientBrush>
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#14000000" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="BadgeFill" Color="#24FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#6344F0" />
                        <GradientStop Offset="1" Color="#0B93B5" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#C8FFFFFF" />
                        <GradientStop Offset="1" Color="#90FFFFFF" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="GlassStroke" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#FFFFFFFF" />
                        <GradientStop Offset="1" Color="#1A000000" />
                    </LinearGradientBrush>
                    <RadialGradientBrush x:Key="GlowA" Center="0.1,0" GradientOrigin="0.1,0" RadiusX="0.7" RadiusY="0.9">
                        <GradientStop Offset="0" Color="#447C5CFF" />
                        <GradientStop Offset="1" Color="#007C5CFF" />
                    </RadialGradientBrush>
                    <RadialGradientBrush x:Key="GlowB" Center="1,1" GradientOrigin="1,1" RadiusX="0.7" RadiusY="0.8">
                        <GradientStop Offset="0" Color="#3322D3EE" />
                        <GradientStop Offset="1" Color="#0022D3EE" />
                    </RadialGradientBrush>
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#40FFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="BadgeFill" Color="#14000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Brand: indigo accent (overrides the Windows accent for every Fluent control) -->
            <Color x:Key="SystemAccentColor">#7C5CFF</Color>
            <Color x:Key="SystemAccentColorLight1">#9479FF</Color>
            <Color x:Key="SystemAccentColorLight2">#AC96FF</Color>
            <Color x:Key="SystemAccentColorLight3">#C9BBFF</Color>
            <Color x:Key="SystemAccentColorDark1">#6744F0</Color>
            <Color x:Key="SystemAccentColorDark2">#5333D0</Color>
            <Color x:Key="SystemAccentColorDark3">#3D23A6</Color>

            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
            <x:Double x:Key="PageMaxWidth">1600</x:Double>
            <Thickness x:Key="PagePadding">24,16,24,24</Thickness>

            <!-- Glass card -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource GlassFill}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassStroke}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- Rounded icon tile in a card corner; set Background to a tint -->
            <Style x:Key="IconBadge" TargetType="Border">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{ThemeResource BadgeFill}" />
            </Style>

            <Style x:Key="CardLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="CardValue" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- The one number a card is about -->
            <Style x:Key="HeroValue" TargetType="TextBlock" BasedOn="{StaticResource CardValue}">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="Foreground" Value="{ThemeResource BrandGradient}" />
            </Style>

            <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="FontSize" Value="32" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{ThemeResource BrandGradient}" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <!-- List header (Controls/GridColumns.cs): sortable cell and the resize divider between cells -->
            <Style x:Key="GridHeaderCell" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="Margin" Value="-4,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="GridHeaderDivider" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="Margin" Value="0,10" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>

            <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- Thin usage bar, e.g. "share of parent" in the tree -->
            <Style x:Key="ShareBar" TargetType="ProgressBar">
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="100" />
                <Setter Property="MinHeight" Value="6" />
                <Setter Property="Height" Value="6" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource BrandGradient}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
