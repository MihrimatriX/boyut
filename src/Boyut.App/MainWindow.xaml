<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Boyut.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Boyut.App.Services"
    Title="Boyut">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusSearch" />
            <KeyboardAccelerator Key="F5" Invoked="OnRescan" />
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenFolder" />
        </Grid.KeyboardAccelerators>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Boyut"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnPaneToggleRequested"
            Subtitle="{x:Bind Session.RootLabel, Mode=OneWay}">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Boyut.png" />
            </TitleBar.IconSource>
            <AutoSuggestBox
                x:Name="GlobalSearch"
                MinWidth="320"
                MaxWidth="560"
                VerticalAlignment="Center"
                IsEnabled="{x:Bind Session.HasIndex, Mode=OneWay}"
                PlaceholderText="Bu taramada ara (Ctrl+F): *.mp4 size:&gt;1gb"
                QueryIcon="Find"
                QuerySubmitted="OnGlobalSearchSubmitted" />
        </TitleBar>

        <!-- Compact rail: the data gets the width; the TitleBar's pane button opens the labels -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="240"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Ana sayfa" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Klasör ağacı" Tag="tree">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Değişimler" Tag="changes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Gelişmiş arama" Tag="search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Temizlik ve türler" Tag="cleanup">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA99;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <InfoBar
                    Margin="16,12,16,0"
                    Closed="OnNoticeClosed"
                    IsOpen="{x:Bind services:Ui.HasText(Session.Notice), Mode=OneWay}"
                    Message="{x:Bind Session.Notice, Mode=OneWay}"
                    Severity="{x:Bind NoticeSeverity(Session.NoticeIsError), Mode=OneWay}" />

                <!-- Scan in progress -->
                <Border
                    Grid.Row="1"
                    Margin="16,12,16,0"
                    Style="{StaticResource Card}"
                    Visibility="{x:Bind Session.IsScanning, Mode=OneWay}">
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ProgressRing
                            Grid.RowSpan="2"
                            Width="28"
                            Height="28"
                            VerticalAlignment="Center"
                            IsActive="{x:Bind Session.IsScanning, Mode=OneWay}" />
                        <Grid Grid.Column="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                MaxLines="1"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextTrimming="CharacterEllipsis">
                                <Run Text="Taranıyor: " /><Run Text="{x:Bind Session.ScanTarget, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource CardLabel}"
                                Text="{x:Bind Session.ProgressText, Mode=OneWay}" />
                        </Grid>
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Spacing="6">
                            <ProgressBar
                                IsIndeterminate="{x:Bind Session.ProgressIndeterminate, Mode=OneWay}"
                                Maximum="100"
                                Value="{x:Bind Session.ProgressValue, Mode=OneWay}" />
                            <TextBlock
                                MaxLines="1"
                                Style="{StaticResource CardLabel}"
                                Text="{x:Bind Session.ProgressDetail, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button
                            Grid.RowSpan="2"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Click="OnCancelScan"
                            Content="İptal" />
                    </Grid>
                </Border>

                <Frame x:Name="ContentFrame" Grid.Row="2" />

                <!-- Status bar -->
                <Grid
                    Grid.Row="3"
                    MinHeight="32"
                    Padding="16,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xEDA2;" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource CardLabel}"
                        Text="{x:Bind Session.StatusText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        ToolTipService.ToolTip="{x:Bind Session.StatusText, Mode=OneWay}" />
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10"
                        Visibility="{x:Bind Session.HasVolumeInfo, Mode=OneWay}">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource CardLabel}"
                            Text="{x:Bind Session.FreeSpaceText, Mode=OneWay}" />
                        <ProgressBar
                            Width="120"
                            Foreground="{x:Bind services:Ui.UsageBrush(Session.UsedPercent), Mode=OneWay}"
                            Style="{StaticResource ShareBar}"
                            Value="{x:Bind Session.UsedPercent, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
